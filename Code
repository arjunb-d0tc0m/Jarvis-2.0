```python
"""
JARVIS 2.0
Local AI + Robotic Arm Controller

AI: Qwen
Runtime: LM Studio
Language: Python

Current version:
- Talks to Qwen through LM Studio
- Maintains conversation history
- Gives Qwen control tools for the robotic arm
- Simulates arm movements
- Ready to connect to Arduino/ESP32 later

Requirements:
    pip install openai

LM Studio:
    Start the Local Server before running this program.
    Default address:
    http://localhost:1234/v1
"""

from openai import OpenAI
import json


# ============================================================
# CONFIGURATION
# ============================================================

LM_STUDIO_URL = "http://localhost:1234/v1"

# IMPORTANT:
# Replace this with the exact model identifier shown by LM Studio.
MODEL = "YOUR_QWEN_MODEL_NAME"


# ============================================================
# CONNECT TO LM STUDIO
# ============================================================

client = OpenAI(
    base_url=LM_STUDIO_URL,
    api_key="lm-studio"
)


# ============================================================
# ROBOT ARM FUNCTIONS
# ============================================================

def move_arm(x, y, z):
    """
    Move the robotic arm.

    At the moment this only simulates movement.
    Later this function will send the command to
    an Arduino or ESP32 connected to the arm.
    """

    print("\n--------------------------------")
    print("🦾 ROBOT ARM")
    print("--------------------------------")
    print(f"Moving to:")
    print(f"X = {x}")
    print(f"Y = {y}")
    print(f"Z = {z}")
    print("--------------------------------\n")

    return {
        "success": True,
        "action": "move_arm",
        "x": x,
        "y": y,
        "z": z
    }


def open_gripper():
    """
    Open the robotic arm's gripper.
    """

    print("\n🦾 Opening gripper...\n")

    return {
        "success": True,
        "action": "open_gripper"
    }


def close_gripper():
    """
    Close the robotic arm's gripper.
    """

    print("\n🦾 Closing gripper...\n")

    return {
        "success": True,
        "action": "close_gripper"
    }


def stop_arm():
    """
    Stop the robotic arm.
    """

    print("\n🛑 EMERGENCY STOP\n")

    return {
        "success": True,
        "action": "stop_arm"
    }


# ============================================================
# TOOLS GIVEN TO QWEN
# ============================================================

tools = [

    {
        "type": "function",
        "function": {
            "name": "move_arm",

            "description": (
                "Move the robotic arm to a specific "
                "X, Y and Z position."
            ),

            "parameters": {
                "type": "object",

                "properties": {

                    "x": {
                        "type": "number",
                        "description": "X position of the arm"
                    },

                    "y": {
                        "type": "number",
                        "description": "Y position of the arm"
                    },

                    "z": {
                        "type": "number",
                        "description": "Z position of the arm"
                    }

                },

                "required": [
                    "x",
                    "y",
                    "z"
                ]
            }
        }
    },

    {
        "type": "function",
        "function": {

            "name": "open_gripper",

            "description": (
                "Open the robotic arm's gripper."
            ),

            "parameters": {
                "type": "object",
                "properties": {}
            }
        }
    },

    {
        "type": "function",
        "function": {

            "name": "close_gripper",

            "description": (
                "Close the robotic arm's gripper."
            ),

            "parameters": {
                "type": "object",
                "properties": {}
            }
        }
    },

    {
        "type": "function",
        "function": {

            "name": "stop_arm",

            "description": (
                "Immediately stop the robotic arm."
            ),

            "parameters": {
                "type": "object",
                "properties": {}
            }
        }
    }
]


# ============================================================
# JARVIS PERSONALITY
# ============================================================

messages = [

    {
        "role": "system",

        "content": """
You are JARVIS 2.0.

You are a personal AI assistant running locally
on the user's computer through LM Studio.

The model powering you is Qwen.

You can communicate with the user and control
a robotic arm through the available tools.

AVAILABLE ARM FUNCTIONS:

1. move_arm
Moves the arm to an X, Y and Z position.

2. open_gripper
Opens the gripper.

3. close_gripper
Closes the gripper.

4. stop_arm
Stops the arm.

IMPORTANT RULES:

- Only use tools when the user actually asks you
  to perform an action.
- Never claim that the robotic arm moved unless
  the tool was actually executed.
- Never invent sensor readings.
- Keep responses concise.
- If a command is unclear, ask the user to clarify.
- The robotic arm is currently being tested in
  simulation.
"""
    }

]


# ============================================================
# TOOL EXECUTION
# ============================================================

def execute_tool(tool_call):

    function_name = tool_call.function.name

    try:

        arguments = json.loads(
            tool_call.function.arguments
        )

    except json.JSONDecodeError:

        return {
            "success": False,
            "error": "Invalid tool arguments."
        }


    # -------------------------
    # MOVE ARM
    # -------------------------

    if function_name == "move_arm":

        return move_arm(
            arguments["x"],
            arguments["y"],
            arguments["z"]
        )


    # -------------------------
    # OPEN GRIPPER
    # -------------------------

    elif function_name == "open_gripper":

        return open_gripper()


    # -------------------------
    # CLOSE GRIPPER
    # -------------------------

    elif function_name == "close_gripper":

        return close_gripper()


    # -------------------------
    # STOP ARM
    # -------------------------

    elif function_name == "stop_arm":

        return stop_arm()


    # -------------------------
    # UNKNOWN COMMAND
    # -------------------------

    return {
        "success": False,
        "error": "Unknown tool."
    }


# ============================================================
# TALK TO JARVIS
# ============================================================

def ask_jarvis(user_message):

    messages.append({
        "role": "user",
        "content": user_message
    })


    # Ask Qwen what to do
    response = client.chat.completions.create(

        model=MODEL,

        messages=messages,

        tools=tools,

        tool_choice="auto",

        temperature=0.4
    )


    assistant_message = response.choices[0].message


    # ========================================================
    # NORMAL RESPONSE
    # ========================================================

    if not assistant_message.tool_calls:

        reply = assistant_message.content

        messages.append({
            "role": "assistant",
            "content": reply
        })

        return reply


    # ========================================================
    # QWEN REQUESTED A TOOL
    # ========================================================

    messages.append({
        "role": "assistant",
        "content": assistant_message.content,
        "tool_calls": assistant_message.tool_calls
    })


    for tool_call in assistant_message.tool_calls:

        print(
            f"\nJARVIS requested: "
            f"{tool_call.function.name}"
        )


        result = execute_tool(tool_call)


        messages.append({

            "role": "tool",

            "tool_call_id": tool_call.id,

            "content": json.dumps(result)

        })


    # ========================================================
    # LET QWEN RESPOND AFTER THE ACTION
    # ========================================================

    final_response = client.chat.completions.create(

        model=MODEL,

        messages=messages,

        temperature=0.4
    )


    reply = final_response.choices[0].message.content


    messages.append({

        "role": "assistant",

        "content": reply

    })


    return reply


# ============================================================
# MAIN PROGRAM
# ============================================================

def main():

    print()
    print("=" * 55)
    print("                 JARVIS 2.0")
    print("=" * 55)
    print("          LOCAL AI ROBOT CONTROLLER")
    print("=" * 55)
    print()
    print("AI: Qwen")
    print("Runtime: LM Studio")
    print("Robot: Simulation")
    print()
    print("Make sure LM Studio's Local Server is running.")
    print()
    print("Type 'exit' to shut down JARVIS.")
    print()


    while True:

        try:

            user_input = input("You: ")


            # -------------------------
            # EXIT
            # -------------------------

            if user_input.lower().strip() == "exit":

                print()
                print("JARVIS: Shutting down.")
                break


            # -------------------------
            # EMPTY MESSAGE
            # -------------------------

            if not user_input.strip():

                continue


            # -------------------------
            # ASK JARVIS
            # -------------------------

            reply = ask_jarvis(user_input)


            print()
            print(f"JARVIS: {reply}")
            print()


        except KeyboardInterrupt:

            print()
            print("JARVIS: Shutting down.")
            break


        except Exception as error:

            print()
            print("ERROR:")
            print(error)
            print()


# ============================================================
# START
# ============================================================

if __name__ == "__main__":

    main()
```

### Before you run it

Install the one dependency:

```bash
pip install openai
```

Then open **LM Studio**, load your Qwen model, start its **Local Server**, and replace:

```python
MODEL = "YOUR_QWEN_MODEL_NAME"
```

with the exact model identifier LM Studio gives you.

For now, try:

```text
You: move the arm to x 20 y 10 z 5
```

You should see JARVIS call the `move_arm` function and print the requested coordinates.

**Don't connect this directly to real motors yet.** The current `move_arm()` is deliberately a simulation. Once you have the actual arm/controller, we can replace that function with serial or Wi-Fi communication and add movement limits, a physical emergency stop, and other safety checks.
