from openai import OpenAI

# LM Studio runs a local OpenAI-compatible API
client = OpenAI(
    base_url="http://localhost:1234/v1",
    api_key="lm-studio"
)

# Change this to the model loaded in LM Studio
MODEL = "YOUR_MODEL_NAME"

conversation = [
    {
        "role": "system",
        "content": """
You are JARVIS 2.0, a personal AI assistant running locally
on the user's computer.

You are helpful, concise and conversational.

JARVIS is being developed to eventually control:
- The user's computer
- A robotic arm
- A camera
- Other hardware and sensors

At the moment, you only have access to conversation.
Never claim that you performed an action unless the program
actually gives you that capability.
"""
    }
]


def ask_jarvis(message):
    conversation.append({
        "role": "user",
        "content": message
    })

    response = client.chat.completions.create(
        model=MODEL,
        messages=conversation,
        temperature=0.7
    )

    reply = response.choices[0].message.content

    conversation.append({
        "role": "assistant",
        "content": reply
    })

    return reply


def main():
    print("=" * 40)
    print("        JARVIS 2.0")
    print("        Local AI Online")
    print("=" * 40)
    print("Type 'exit' to shut down.\n")

    while True:
        try:
            user_input = input("You: ")

            if user_input.lower().strip() == "exit":
                print("JARVIS: Shutting down.")
                break

            if not user_input.strip():
                continue

            reply = ask_jarvis(user_input)
            print(f"\nJARVIS: {reply}\n")

        except KeyboardInterrupt:
            print("\nJARVIS: Shutting down.")
            break

        except Exception as error:
            print(f"\nError: {error}\n")


if __name__ == "__main__":
    main()
